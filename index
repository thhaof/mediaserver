      },
      {
        id: 4,
        title: "夜に駆ける (Racing Into The Night)",
        artist: "YOASOBI",
        dateAdded: "May 17 · 2026, 22:11",
        duration: "4:18",
        type: "audio",
        cover: "https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=150&auto=format&fit=crop&q=80",
        url: "https://cdn.pixabay.com/download/audio/2022/10/14/audio_9939f79220.mp3?filename=electronic-future-beats-117997.mp3"
      },
      {
        id: 5,
        title: "もう少しだけ (Just A Little More)",
        artist: "YOASOBI",
        dateAdded: "May 17 · 2026, 22:11",
        duration: "3:38",
        type: "audio",
        cover: "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=150&auto=format&fit=crop&q=80",
        url: "https://cdn.pixabay.com/download/audio/2022/03/10/audio_c2f7b49463.mp3?filename=soft-piano-10783.mp3"
      },
      {
        id: 6,
        title: "優しい彗星 (Comet)",
        artist: "YOASOBI",
        dateAdded: "May 17 · 2026, 22:12",
        duration: "3:33",
        type: "audio",
        cover: "https://images.unsplash.com/photo-1470225620780-dba8ba36b745?w=150&auto=format&fit=crop&q=80",
        url: "https://cdn.pixabay.com/download/audio/2022/05/16/audio_db6591201e.mp3?filename=acoustic-guitars-11023.mp3"
      },
      {
        id: 7,
        title: "怪物 (Monster - Live Stream Performance)",
        artist: "YOASOBI",
        dateAdded: "May 17 · 2026, 22:12",
        duration: "3:25",
        type: "video",
        cover: "https://images.unsplash.com/photo-1492684223066-81342ee5ff30?w=150&auto=format&fit=crop&q=80",
        url: "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4"
      }
    ];

    // Player State Variables
    let currentTrackIndex = 2; // Default to "Gunjou"
    let isPlaying = false;
    let isShuffle = false;
    let isRepeat = false;
    let tracksPlayedCount = 17;
    let listeningTimeMinutes = 49;

    // HTML Audio Element
    const audioPlayer = new Audio();
    audioPlayer.crossOrigin = "anonymous";

    function renderTracks(items = trackData) {
      const tbody = document.getElementById('trackTableBody');
      tbody.innerHTML = '';

      items.forEach((track, index) => {
        const isCurrent = index === currentTrackIndex;
        const tr = document.createElement('tr');
        
        tr.className = `group hover:bg-dark-surface/80 transition-colors cursor-pointer ${
          isCurrent ? 'bg-dark-surface/90 text-brand-400 border-l-4 border-brand-400' : 'text-gray-300'
        }`;
        
        tr.onclick = () => playTrack(index);

        tr.innerHTML = `
          <td class="py-3 px-4 text-center font-mono text-xs ${isCurrent ? 'text-brand-400 font-bold' : 'text-gray-500'}">
            ${isCurrent && isPlaying 
              ? '<i class="fa-solid fa-volume-high animate-bounce text-brand-400"></i>' 
              : (index + 1)}
          </td>
          <td class="py-3 px-4">
            <div class="flex items-center space-x-3">
              <img src="${track.cover}" class="w-9 h-9 rounded-lg object-cover flex-shrink-0 shadow-sm border border-dark-border">
              <span class="font-bold truncate ${isCurrent ? 'text-brand-400' : 'text-gray-100 group-hover:text-brand-400'}">
                ${track.title}
              </span>
            </div>
          </td>
          <td class="py-3 px-4 hidden md:table-cell text-gray-400 truncate">${track.artist}</td>
          <td class="py-3 px-4 hidden lg:table-cell text-gray-500 text-[11px] font-mono">${track.dateAdded}</td>
          <td class="py-3 px-4 text-center">
            ${track.type === 'video' 
              ? '<span class="text-[10px] bg-purple-500/20 text-purple-300 border border-purple-500/30 px-2 py-0.5 rounded-full"><i class="fa-solid fa-film"></i> VIDEO</span>'
              : '<span class="text-[10px] bg-brand-400/10 text-brand-400 border border-brand-400/20 px-2 py-0.5 rounded-full"><i class="fa-solid fa-music"></i> AUDIO</span>'}
          </td>
          <td class="py-3 px-4 text-right font-mono text-gray-400 text-xs">${track.duration}</td>
        `;
        tbody.appendChild(tr);
      });

      document.getElementById('playlistTrackCount').innerHTML = `<i class="fa-solid fa-music text-gray-500"></i> ${items.length} songs`;
    }

    // Play Track Function
    function playTrack(index) {
      if (index < 0 || index >= trackData.length) return;
      currentTrackIndex = index;
      const track = trackData[index];

      // Update Session Stats
      tracksPlayedCount++;
      document.getElementById('statTracks').innerText = tracksPlayedCount;

      // Update Player UI Info
      document.getElementById('playerTitle').innerText = track.title;
      document.getElementById('playerArtist').innerText = track.artist;
      document.getElementById('playerCover').src = track.cover;
      document.getElementById('playerTypeTag').innerText = track.type === 'video' ? 'R2 VIDEO STREAM' : 'R2 AUDIO STREAM';
      
      const videoBadge = document.getElementById('videoBadge');
      if (track.type === 'video') {
        videoBadge.classList.remove('hidden');
        document.getElementById('videoSource').src = track.url;
        document.getElementById('html5VideoPlayer').load();
        document.getElementById('videoModalTitle').innerText = track.title;
      } else {
        videoBadge.classList.add('hidden');
      }

      // Load & Play Audio
      audioPlayer.src = track.url;
      audioPlayer.play().then(() => {
        isPlaying = true;
        updatePlayButtonUI();
      }).catch(err => {
        console.log("Autoplay hindered or streaming source loading:", err);
      });

      renderTracks();
    }

    function togglePlayPause() {
      if (!audioPlayer.src) {
        playTrack(currentTrackIndex);
        return;
      }

      if (isPlaying) {
        audioPlayer.pause();
        isPlaying = false;
      } else {
        audioPlayer.play();
        isPlaying = true;
      }
      updatePlayButtonUI();
      renderTracks();
    }

    function updatePlayButtonUI() {
      const btn = document.getElementById('mainPlayBtn');
      btn.innerHTML = isPlaying 
        ? '<i class="fa-solid fa-pause text-sm"></i>' 
        : '<i class="fa-solid fa-play text-sm ml-0.5"></i>';
    }

    function playNext() {
      let nextIndex;
      if (isShuffle) {
        nextIndex = Math.floor(Math.random() * trackData.length);
      } else {
        nextIndex = (currentTrackIndex + 1) % trackData.length;
      }
      playTrack(nextIndex);
    }

    function playPrev() {
      let prevIndex = (currentTrackIndex - 1 + trackData.length) % trackData.length;
      playTrack(prevIndex);
    }

    function seekTrack(value) {
      if (audioPlayer.duration) {
        audioPlayer.currentTime = (value / 100) * audioPlayer.duration;
      }
    }

    function setVolume(val) {
      audioPlayer.volume = val / 100;
      document.getElementById('volumePercentage').innerText = `${val}%`;
    }

    function toggleMute() {
      audioPlayer.muted = !audioPlayer.muted;
      document.getElementById('volumeIcon').innerHTML = audioPlayer.muted 
        ? '<i class="fa-solid fa-volume-xmark text-red-400"></i>' 
        : '<i class="fa-solid fa-volume-high"></i>';
    }

    function toggleShuffle() {
      isShuffle = !isShuffle;
      const btn = document.getElementById('playerShuffleBtn');
      const headerBtn = document.getElementById('shuffleBtn');
      if (isShuffle) {
        btn.classList.add('text-brand-400');
        headerBtn.classList.add('border-brand-400', 'text-brand-400');
      } else {
        btn.classList.remove('text-brand-400');
        headerBtn.classList.remove('border-brand-400', 'text-brand-400');
      }
    }

    function toggleRepeat() {
      isRepeat = !isRepeat;
      audioPlayer.loop = isRepeat;
      const btn = document.getElementById('playerRepeatBtn');
      btn.classList.toggle('text-brand-400', isRepeat);
    }

    // Format Seconds to MM:SS
    function formatTime(seconds) {
      if (isNaN(seconds)) return "0:00";
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
    }

    // Audio Event Listeners
    audioPlayer.addEventListener('timeupdate', () => {
      if (audioPlayer.duration) {
        const progress = (audioPlayer.currentTime / audioPlayer.duration) * 100;
        document.getElementById('progressBar').value = progress;
        document.getElementById('currentTimeDisplay').innerText = formatTime(audioPlayer.currentTime);
        document.getElementById('durationDisplay').innerText = formatTime(audioPlayer.duration);
      }
    });

    audioPlayer.addEventListener('ended', () => {
      if (!isRepeat) {
        playNext();
      }
    });

    // Search Filter
    function filterSongs() {
      const q = document.getElementById('searchInput').value.toLowerCase();
      const filtered = trackData.filter(t => 
        t.title.toLowerCase().includes(q) || t.artist.toLowerCase().includes(q)
      );
      renderTracks(filtered);
    }

    // Modals
    function toggleR2Modal() {
      document.getElementById('r2Modal').classList.toggle('hidden');
    }

    function saveR2Settings() {
      toggleR2Modal();
    }

    function toggleVideoView() {
      const modal = document.getElementById('videoModal');
      modal.classList.toggle('hidden');
    }

    function openImportModal() {
      document.getElementById('importModal').classList.remove('hidden');
    }

    function closeImportModal() {
      document.getElementById('importModal').classList.add('hidden');
    }

    function addNewTrack() {
      const title = document.getElementById('newTrackTitle').value || 'Untitled R2 Media';
      const artist = document.getElementById('newTrackArtist').value || 'Unknown Artist';
      const type = document.getElementById('newMediaType').value;
      const url = document.getElementById('newTrackUrl').value || 'https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3';

      trackData.unshift({
        id: trackData.length + 1,
        title: title,
        artist: artist,
        dateAdded: "Just now",
        duration: "3:45",
        type: type,
        cover: type === 'video' 
          ? 'https://images.unsplash.com/photo-1492684223066-81342ee5ff30?w=150&auto=format&fit=crop&q=80'
          : 'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=150&auto=format&fit=crop&q=80',
        url: url
      });

      renderTracks();
      closeImportModal();
    }

    function selectPlaylist(name) {
      document.getElementById('playlistTitle').innerText = name;
    }

    // Animated Spectrum Waveform Canvas
    const canvas = document.getElementById('waveformCanvas');
    const ctx = canvas.getContext('2d');

    function resizeCanvas() {
      canvas.width = canvas.parentElement.clientWidth;
      canvas.height = 20;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    // Canvas Audio Visualizer simulation bars
    function drawVisualizer() {
      requestAnimationFrame(drawVisualizer);
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      const barWidth = 3;
      const gap = 2;
      const totalBars = Math.floor(canvas.width / (barWidth + gap));
      
      for (let i = 0; i < totalBars; i++) {
        let barHeight = isPlaying 
          ? Math.random() * canvas.height * 0.85 + 2 
          : Math.sin(i * 0.2) * 3 + 4;

        const x = i * (barWidth + gap);
        const y = canvas.height - barHeight;

        const gradient = ctx.createLinearGradient(0, 0, 0, canvas.height);
        gradient.addColorStop(0, '#00f2fe');
        gradient.addColorStop(1, '#00a3cc');

        ctx.fillStyle = gradient;
        ctx.fillRect(x, y, barWidth, barHeight);
      }
    }

    // Initialize Page
    window.onload = () => {
      renderTracks();
      drawVisualizer();
    };
  </script>
