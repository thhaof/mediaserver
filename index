<!DOCTYPE html>
<html lang="en" class="h-full bg-[#0B0D13] text-gray-100 dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PulseStream Server | R2 Dark Media Player</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts: Inter -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#e6ffff',
              100: '#b3ffff',
              400: '#00f2fe',
              500: '#00d2ff',
              600: '#00a3cc',
              glow: '#00f2fe22'
            },
            dark: {
              bg: '#080A0F',
              panel: '#10141D',
              surface: '#171D2A',
              hover: '#20293C',
              border: '#2A354A',
            }
          },
          boxShadow: {
            'glow-cyan': '0 0 20px rgba(0, 242, 254, 0.35)',
            'glow-sm': '0 0 10px rgba(0, 242, 254, 0.2)',
            'inner-dark': 'inset 0 2px 4px 0 rgba(0, 0, 0, 0.6)'
          }
        }
      }
    }
  </script>

  <style>
    /* Custom scrollbar for dark tone */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #080A0F;
    }
    ::-webkit-scrollbar-thumb {
      background: #2A354A;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #00d2ff;
    }

    /* Range slider custom styling */
    input[type=range] {
      -webkit-appearance: none;
      background: transparent;
    }
    input[type=range]:focus {
      outline: none;
    }
    input[type=range]::-webkit-slider-runnable-track {
      width: 100%;
      height: 6px;
      cursor: pointer;
      background: #2A354A;
      border-radius: 9999px;
    }
    input[type=range]::-webkit-slider-thumb {
      height: 14px;
      width: 14px;
      border-radius: 50%;
      background: #00f2fe;
      cursor: pointer;
      -webkit-appearance: none;
      margin-top: -4px;
      box-shadow: 0 0 10px #00f2fe;
    }

    .border-glow {
      box-shadow: 0 0 12px -2px rgba(0, 242, 254, 0.3);
    }
  </style>
</head>
<body class="h-full flex flex-col font-sans overflow-hidden bg-dark-bg text-gray-200 select-none">

  <div id="app" class="flex flex-col h-screen w-full relative">

    <!-- Top Navigation Header -->
    <header class="h-16 bg-dark-panel border-b border-dark-border px-6 flex items-center justify-between z-10 flex-shrink-0">
      <div class="flex items-center space-x-4">
        <!-- Logo -->
        <div class="flex items-center space-x-3 cursor-pointer" onclick="toggleR2Modal()">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-brand-600 to-brand-400 flex items-center justify-center text-dark-bg shadow-glow-sm">
            <i class="fa-solid fa-waveform fa-lg"></i>
          </div>
          <div>
            <h1 class="font-extrabold text-lg tracking-wider text-white flex items-center gap-2">
              PULSE<span class="text-brand-400">R2</span>
              <span class="text-[10px] bg-brand-400/10 text-brand-400 border border-brand-400/30 px-2 py-0.5 rounded-full font-mono">Cloudflare Connected</span>
            </h1>
          </div>
        </div>
      </div>

      <!-- Quick Search -->
      <div class="relative w-72 hidden md:block">
        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-sm"></i>
        <input type="text" id="searchInput" onkeyup="filterSongs()" placeholder="Search track, artist, or tag..." 
          class="w-full bg-dark-surface border border-dark-border text-xs rounded-full pl-9 pr-4 py-2 focus:outline-none focus:border-brand-400 text-gray-200 placeholder-gray-500 transition-all">
      </div>

      <!-- User Profile Badge & R2 Settings trigger -->
      <div class="flex items-center space-x-4">
        <button onclick="toggleR2Modal()" class="text-xs bg-dark-surface hover:bg-dark-hover border border-dark-border px-3 py-1.5 rounded-lg flex items-center gap-2 text-gray-300 transition-all">
          <i class="fa-solid fa-cloud text-brand-400"></i>
          <span class="hidden sm:inline">R2 Config</span>
        </button>
        <div class="flex items-center space-x-3 bg-dark-surface border border-dark-border rounded-xl px-3 py-1.5">
          <div class="relative">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-r from-purple-500 to-indigo-600 flex items-center justify-center font-bold text-white text-xs">
              CA
            </div>
            <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 bg-emerald-500 border-2 border-dark-panel rounded-full"></span>
          </div>
          <div class="text-xs">
            <div class="font-bold text-gray-100">WELCOME, CAROLINE</div>
            <div class="text-[10px] text-gray-400">Admin / Streaming User</div>
          </div>
        </div>
      </div>
    </header>

    <div class="flex flex-1 overflow-hidden">
      
      <!-- Left Sidebar -->
      <aside class="w-64 bg-dark-panel border-r border-dark-border p-4 flex flex-col justify-between overflow-y-auto flex-shrink-0">
        <div class="space-y-6">
          
          <!-- Navigation -->
          <div>
            <div class="text-[11px] font-semibold tracking-wider text-gray-500 uppercase mb-3 px-2">Navigation</div>
            <nav class="space-y-1">
              <a href="#" class="flex items-center space-x-3 px-3 py-2 rounded-lg text-sm font-medium bg-brand-400/10 text-brand-400 border-l-2 border-brand-400">
                <i class="fa-solid fa-database w-5"></i>
                <span>Database</span>
              </a>
              <a href="#" class="flex items-center space-x-3 px-3 py-2 rounded-lg text-sm font-medium text-gray-400 hover:text-gray-200 hover:bg-dark-surface transition-colors">
                <i class="fa-solid fa-film w-5 text-purple-400"></i>
                <span>Video Vault</span>
                <span class="ml-auto text-[10px] bg-purple-500/20 text-purple-300 px-1.5 py-0.5 rounded font-mono">NEW</span>
              </a>
              <a href="#" class="flex items-center space-x-3 px-3 py-2 rounded-lg text-sm font-medium text-gray-400 hover:text-gray-200 hover:bg-dark-surface transition-colors">
                <i class="fa-solid fa-chart-line w-5"></i>
                <span>Analytics</span>
              </a>
            </nav>
          </div>

          <!-- SESSION STATS BOX (Inspired by Reference UI) -->
          <div class="bg-dark-surface border border-dark-border rounded-xl p-3.5 space-y-3 relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-24 h-24 bg-brand-400/5 rounded-full blur-xl pointer-events-none"></div>
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-2 text-xs font-bold text-brand-400 tracking-wider">
                <i class="fa-solid fa-bolt-lightning animate-pulse"></i>
                <span>SESSION STATS</span>
              </div>
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            </div>
            
            <div class="grid grid-cols-2 gap-2 pt-1">
              <div class="bg-dark-panel/60 p-2 rounded-lg border border-dark-border/50">
                <div class="text-[10px] text-gray-400">Tracks Played</div>
                <div id="statTracks" class="text-base font-bold text-white mt-0.5">17</div>
              </div>
              <div class="bg-dark-panel/60 p-2 rounded-lg border border-dark-border/50">
                <div class="text-[10px] text-gray-400">Listening Time</div>
                <div id="statTime" class="text-base font-bold text-white mt-0.5">49 min</div>
              </div>
            </div>
            
            <div class="text-[10px] text-gray-400 flex items-center justify-between pt-1 border-t border-dark-border/40">
              <span>R2 Egress Bandwidth</span>
              <span class="text-emerald-400 font-mono">0.00 $ (Free)</span>
            </div>
          </div>

          <!-- COLLECTIONS & PLAYLISTS -->
          <div class="space-y-3">
            <div class="flex items-center justify-between px-2">
              <span class="text-[11px] font-semibold tracking-wider text-gray-500 uppercase">Collections</span>
              <button onclick="createNewPlaylist()" class="text-gray-400 hover:text-brand-400 text-xs transition-colors">
                <i class="fa-solid fa-plus"></i>
              </button>
            </div>

            <div class="space-y-1">
              <div class="text-[10px] font-semibold text-brand-400 px-2 tracking-wider flex items-center gap-1">
                <i class="fa-solid fa-star text-[9px]"></i> YOUR PLAYLISTS
              </div>
              
              <div class="space-y-1 pl-1">
                <button onclick="selectPlaylist('Carol')" class="w-full flex items-center space-x-2.5 px-3 py-2 rounded-lg text-xs font-medium bg-dark-surface border border-brand-400/40 text-brand-400 shadow-glow-sm transition-all">
                  <i class="fa-solid fa-folder-open text-brand-400"></i>
                  <span class="truncate">Carol</span>
                  <span class="ml-auto text-[10px] bg-brand-400/20 text-brand-400 px-1.5 py-0.5 rounded-full font-mono">ACTIVE</span>
                </button>
                <button onclick="selectPlaylist('Chill Hits')" class="w-full flex items-center space-x-2.5 px-3 py-2 rounded-lg text-xs font-medium text-gray-400 hover:text-gray-200 hover:bg-dark-surface transition-all">
                  <i class="fa-solid fa-folder text-gray-500"></i>
                  <span class="truncate">Chill Hits</span>
                </button>
                <button onclick="selectPlaylist('Anime Openings')" class="w-full flex items-center space-x-2.5 px-3 py-2 rounded-lg text-xs font-medium text-gray-400 hover:text-gray-200 hover:bg-dark-surface transition-all">
                  <i class="fa-solid fa-folder text-gray-500"></i>
                  <span class="truncate">Anime Openings</span>
                </button>
              </div>
            </div>

            <!-- SHARED PLAYLISTS -->
            <div class="space-y-1 pt-2">
              <div class="text-[10px] font-semibold text-gray-500 px-2 tracking-wider flex items-center gap-1">
                <i class="fa-solid fa-users text-[9px]"></i> SHARED PLAYLISTS
              </div>
              
              <div class="space-y-1 pl-1">
                <div class="flex items-center justify-between px-3 py-1.5 text-xs text-gray-400 hover:bg-dark-surface rounded-lg cursor-pointer">
                  <span class="flex items-center gap-2 truncate"><i class="fa-solid fa-headphones text-gray-500"></i> test</span>
                  <span class="text-[9px] bg-dark-border px-1.5 py-0.5 rounded text-gray-400 uppercase font-mono">ADMIN</span>
                </div>
                <div class="flex items-center justify-between px-3 py-1.5 text-xs text-gray-400 hover:bg-dark-surface rounded-lg cursor-pointer">
                  <span class="flex items-center gap-2 truncate"><i class="fa-solid fa-headphones text-gray-500"></i> Brian</span>
                  <span class="text-[9px] bg-dark-border px-1.5 py-0.5 rounded text-gray-400 uppercase font-mono">BRIAN</span>
                </div>
                <div class="flex items-center justify-between px-3 py-1.5 text-xs text-gray-400 hover:bg-dark-surface rounded-lg cursor-pointer">
                  <span class="flex items-center gap-2 truncate"><i class="fa-solid fa-headphones text-gray-500"></i> Jpop</span>
                  <span class="text-[9px] bg-dark-border px-1.5 py-0.5 rounded text-gray-400 uppercase font-mono">BRIAN</span>
                </div>
                <div class="flex items-center justify-between px-3 py-1.5 text-xs text-gray-400 hover:bg-dark-surface rounded-lg cursor-pointer">
                  <span class="flex items-center gap-2 truncate"><i class="fa-solid fa-headphones text-gray-500"></i> MEOW</span>
                  <span class="text-[9px] bg-dark-border px-1.5 py-0.5 rounded text-gray-400 uppercase font-mono">CARAMEOW</span>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- R2 Storage Status Bar Footer -->
        <div class="pt-4 border-t border-dark-border mt-auto">
          <div class="flex items-center justify-between text-[11px] text-gray-400 mb-1">
            <span class="flex items-center gap-1"><i class="fa-solid fa-hard-drive text-brand-400"></i> R2 Bucket Usage</span>
            <span class="font-mono text-gray-200">1.4 GB / 10 GB</span>
          </div>
          <div class="w-full bg-dark-surface rounded-full h-1.5 overflow-hidden">
            <div class="bg-gradient-to-r from-brand-600 to-brand-400 h-full rounded-full" style="width: 14%"></div>
          </div>
        </div>
      </aside>

      <!-- Main Content Area -->
      <main class="flex-1 bg-dark-bg flex flex-col overflow-y-auto p-6 space-y-6">

        <!-- PLAYLIST HEADER BANNER -->
        <div class="bg-dark-panel border border-dark-border rounded-2xl p-5 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-xl relative overflow-hidden">
          <div class="absolute -right-12 -bottom-12 w-64 h-64 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>

          <div class="flex items-center space-x-5 z-10">
            <!-- Playlist Cover Mosaic Grid -->
            <div class="w-20 h-20 md:w-24 md:h-24 rounded-xl overflow-hidden grid grid-cols-2 grid-rows-2 gap-0.5 bg-dark-border flex-shrink-0 shadow-lg">
              <img src="https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=150&auto=format&fit=crop&q=80" class="w-full h-full object-cover">
              <img src="https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=150&auto=format&fit=crop&q=80" class="w-full h-full object-cover">
              <img src="https://images.unsplash.com/photo-1470225620780-dba8ba36b745?w=150&auto=format&fit=crop&q=80" class="w-full h-full object-cover">
              <img src="https://images.unsplash.com/photo-1508700115892-45ecd05ae2ad?w=150&auto=format&fit=crop&q=80" class="w-full h-full object-cover">
            </div>

            <!-- Details -->
            <div>
              <div class="text-xs font-semibold text-brand-400 tracking-wider uppercase mb-1">YOUR PLAYLIST</div>
              <h2 id="playlistTitle" class="text-2xl md:text-3xl font-extrabold text-white tracking-tight">Carol</h2>
              <div class="text-xs text-gray-400 mt-1 flex items-center gap-3">
                <span id="playlistTrackCount"><i class="fa-solid fa-music text-gray-500"></i> 71 songs</span>
                <span>•</span>
                <span>39 artists</span>
                <span>•</span>
                <span>4h 39m total</span>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex items-center flex-wrap gap-2.5 z-10 w-full md:w-auto">
            <button onclick="playTrack(0)" class="flex-1 md:flex-initial bg-brand-400 hover:bg-brand-500 text-dark-bg font-bold px-5 py-2.5 rounded-xl flex items-center justify-center gap-2 transition-all shadow-glow-cyan">
              <i class="fa-solid fa-play fill-current"></i> Play All
            </button>
            <button onclick="toggleShuffle()" id="shuffleBtn" class="bg-dark-surface hover:bg-dark-hover border border-dark-border text-gray-200 font-semibold px-4 py-2.5 rounded-xl text-xs flex items-center justify-center gap-2 transition-all">
              <i class="fa-solid fa-shuffle"></i> Shuffle
            </button>
            <button onclick="openImportModal()" class="bg-dark-surface hover:bg-dark-hover border border-dark-border text-gray-200 font-semibold px-4 py-2.5 rounded-xl text-xs flex items-center justify-center gap-2 transition-all">
              <i class="fa-solid fa-cloud-arrow-up text-brand-400"></i> Add R2 Media
            </button>
          </div>
        </div>

        <!-- MEDIA TABLE LIST (AUDIO & VIDEO ITEMS) -->
        <div class="bg-dark-panel border border-dark-border rounded-2xl overflow-hidden shadow-xl flex-1 flex flex-col">
          <div class="overflow-x-auto flex-1">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="border-b border-dark-border text-[11px] font-semibold text-gray-400 uppercase tracking-wider">
                  <th class="py-3 px-4 w-12 text-center">#</th>
                  <th class="py-3 px-4">Title</th>
                  <th class="py-3 px-4 hidden md:table-cell">Artist / Creator</th>
                  <th class="py-3 px-4 hidden lg:table-cell">Date Added</th>
                  <th class="py-3 px-4 text-center w-16"><i class="fa-solid fa-photo-film text-xs"></i> Mode</th>
                  <th class="py-3 px-4 text-right w-20"><i class="fa-regular fa-clock"></i></th>
                </tr>
              </thead>
              <tbody id="trackTableBody" class="divide-y divide-dark-border/40 text-xs font-medium">
                <!-- Tracks rendered via JavaScript -->
              </tbody>
            </table>
          </div>
        </div>

      </main>
    </div>

    <!-- PERSISTENT FOOTER MEDIA PLAYER BAR -->
    <footer class="h-24 bg-dark-panel border-t border-dark-border px-4 md:px-6 flex items-center justify-between z-20 flex-shrink-0 relative overflow-hidden">
      
      <!-- Ambient Visualizer Overlay Background -->
      <div class="absolute inset-0 pointer-events-none opacity-20">
        <canvas id="bgVisualizerCanvas" class="w-full h-full"></canvas>
      </div>

      <!-- Current Track Info -->
      <div class="flex items-center space-x-3.5 w-1/4 min-w-[200px] z-10">
        <div class="relative group flex-shrink-0">
          <img id="playerCover" src="https://images.unsplash.com/photo-1614613535308-eb5fbd3d2c17?w=150&auto=format&fit=crop&q=80" 
            class="w-14 h-14 rounded-xl object-cover border border-dark-border shadow-md">
          <div id="videoBadge" class="hidden absolute top-1 right-1 bg-purple-600 text-white text-[9px] px-1 rounded font-bold uppercase">
            VIDEO
          </div>
        </div>
        <div class="overflow-hidden">
          <h4 id="playerTitle" class="text-sm font-bold text-white truncate">群青 (Gunjou)</h4>
          <p id="playerArtist" class="text-xs text-gray-400 truncate mt-0.5">YOASOBI</p>
          <span id="playerTypeTag" class="inline-block mt-1 text-[9px] text-brand-400 bg-brand-400/10 px-1.5 py-0.2 rounded font-mono">
            R2 AUDIO STREAM
          </span>
        </div>
      </div>

      <!-- Center Controls & Progress Bar -->
      <div class="flex flex-col items-center justify-center space-y-2 w-2/4 max-w-2xl z-10 px-4">
        
        <!-- Controls Buttons -->
        <div class="flex items-center space-x-6">
          <button onclick="toggleShuffle()" id="playerShuffleBtn" class="text-gray-400 hover:text-brand-400 text-xs transition-colors">
            <i class="fa-solid fa-shuffle"></i>
          </button>
          <button onclick="playPrev()" class="text-gray-300 hover:text-white text-sm transition-colors">
            <i class="fa-solid fa-backward-step"></i>
          </button>
          <button onclick="togglePlayPause()" id="mainPlayBtn" class="w-10 h-10 rounded-full bg-white text-dark-bg hover:scale-105 transition-all flex items-center justify-center shadow-glow-cyan">
            <i class="fa-solid fa-play text-sm ml-0.5"></i>
          </button>
          <button onclick="playNext()" class="text-gray-300 hover:text-white text-sm transition-colors">
            <i class="fa-solid fa-forward-step"></i>
          </button>
          <button onclick="toggleRepeat()" id="playerRepeatBtn" class="text-gray-400 hover:text-brand-400 text-xs transition-colors">
            <i class="fa-solid fa-repeat"></i>
          </button>
        </div>

        <!-- Progress Timeline + Live Spectrum Bar Canvas -->
        <div class="w-full flex items-center space-x-3">
          <span id="currentTimeDisplay" class="text-[10px] font-mono text-gray-400 w-8 text-right">0:00</span>
          
          <div class="flex-1 relative flex items-center group">
            <!-- Spectrum Visualizer embedded directly over progress track -->
            <canvas id="waveformCanvas" class="w-full h-5 absolute -top-5 opacity-80 pointer-events-none"></canvas>
            
            <input type="range" id="progressBar" min="0" max="100" value="0" oninput="seekTrack(this.value)" 
              class="w-full z-10">
          </div>

          <span id="durationDisplay" class="text-[10px] font-mono text-gray-400 w-8">4:08</span>
        </div>

      </div>

      <!-- Right Side Controls & Video Switch -->
      <div class="flex items-center justify-end space-y-0 space-x-4 w-1/4 min-w-[180px] z-10">
        
        <!-- Video Canvas/Modal Toggle Button -->
        <button onclick="toggleVideoView()" id="videoToggleBtn" class="text-xs bg-dark-surface hover:bg-dark-hover border border-dark-border px-2.5 py-1.5 rounded-lg text-gray-300 flex items-center gap-1.5 transition-all">
          <i class="fa-solid fa-display text-purple-400"></i>
          <span class="hidden xl:inline text-[11px]">Player View</span>
        </button>

        <!-- Volume Bar -->
        <div class="flex items-center space-x-2">
          <button onclick="toggleMute()" id="volumeIcon" class="text-gray-400 hover:text-white text-xs">
            <i class="fa-solid fa-volume-high"></i>
          </button>
          <input type="range" id="volumeSlider" min="0" max="100" value="70" oninput="setVolume(this.value)" class="w-16 md:w-20">
          <span id="volumePercentage" class="text-[10px] font-mono text-gray-400 w-6">70%</span>
        </div>
      </div>

    </footer>

  </div>

  <!-- CLOUDFLARE R2 CONFIG MODAL -->
  <div id="r2Modal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4">
    <div class="bg-dark-panel border border-dark-border rounded-2xl w-full max-w-lg p-6 shadow-2xl space-y-5">
      <div class="flex items-center justify-between border-b border-dark-border pb-3">
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded-lg bg-brand-400/10 border border-brand-400/30 flex items-center justify-center text-brand-400">
            <i class="fa-solid fa-cloud"></i>
          </div>
          <h3 class="text-lg font-bold text-white">Cloudflare R2 Bucket Settings</h3>
        </div>
        <button onclick="toggleR2Modal()" class="text-gray-400 hover:text-white"><i class="fa-solid fa-xmark"></i></button>
      </div>

      <p class="text-xs text-gray-400 leading-relaxed">
        Connect your custom R2 bucket domain or S3 API endpoint. Files are streamed with 0$ egress bandwidth cost.
      </p>

      <div class="space-y-4 text-xs">
        <div>
          <label class="block text-gray-300 font-medium mb-1">R2 Public Bucket Endpoint / Custom Domain</label>
          <input type="text" id="r2EndpointInput" value="https://pub-media-server.r2.dev" 
            class="w-full bg-dark-surface border border-dark-border rounded-lg px-3 py-2 text-gray-200 focus:outline-none focus:border-brand-400 font-mono">
        </div>

        <div>
          <label class="block text-gray-300 font-medium mb-1">Bucket Name</label>
          <input type="text" value="carol-media-vault" 
            class="w-full bg-dark-surface border border-dark-border rounded-lg px-3 py-2 text-gray-200 focus:outline-none focus:border-brand-400 font-mono">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-gray-300 font-medium mb-1">Access Key ID (Optional)</label>
            <input type="password" value="••••••••••••••••" 
