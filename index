          <select id="newMediaType" class="w-full bg-dark-surface border border-dark-border rounded-lg px-3 py-2 text-gray-200 focus:outline-none focus:border-brand-400">
            <option value="audio">Audio (MP3 / FLAC / AAC)</option>
            <option value="video">Video Stream (MP4 / WebM / HLS)</option>
